# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE ONLY — PLACEHOLDER VALUES.
#
# This file is COMMITTED TO GIT. Never put a real credential, secret, internal
# hostname or API key in it. Copy it to `backend/.env` (git-ignored) and fill
# the real values there:
#
#   cp backend/.env.example backend/.env
#
# Every `CHANGE_ME` / `your_*` value below must be replaced in your own .env.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
# Required in production. Comma-separated list of allowed frontend origins.
# Example: ALLOWED_ORIGINS=https://meatbiz.posora.vn,https://app.posora.vn
ALLOWED_ORIGINS=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=CHANGE_ME
DB_NAME=meat_business_db
# Must be a long, random, per-environment value. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse across environments, and never commit the real value.
JWT_SECRET=CHANGE_ME
ALLOW_PLAIN_PASSWORD=true
PUBLIC_APP_URL=http://localhost:5173
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_PROJECT_ID=your-gcp-project-id
DOCUMENT_AI_PROCESSOR_ID=your-document-ai-processor-id
DOCUMENT_AI_LOCATION=us

# V15 Production Auth & Verification
SUPPORT_EMAIL=support@example.com
PUBLIC_APP_URL=https://app.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@example.com
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
RETURN_DEV_OTP=false
REQUIRE_PHONE_VERIFY_FOR_APPROVAL=false

# Mail server
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_mail_user@example.com
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=support@example.com
SUPPORT_EMAIL=support@example.com
PUBLIC_APP_URL=http://localhost:5173

# SMS OTP is disabled in V16. Use email verification/reset.
PHONE_OTP_STATUS=DEVELOPING

# V19 AI error notification mail
SUPPORT_EMAIL=support@example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_mail_user@example.com
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=support@example.com

# V20 Production file logging
LOG_DIR=./logs
LOG_MAX_TEXT=12000

# ── Log retention (H-6) ──
# Days to keep date-stamped log files under LOG_DIR. 0 disables pruning.
LOG_RETENTION_DAYS=30

# ── Health probe ──
# Bound on the /api/health database check, in ms.
HEALTH_DB_TIMEOUT_MS=3000
